  <media:Image id="img-F2" src="../assets/shots/F2.png"/>
  <media:Image id="img-F3" src="../assets/shots/F3.png"/>
  <media:Image id="img-F4" src="../assets/shots/F4.png"/>
  <media:Image id="img-G1" src="../assets/shots/G1.png"/>
  <media:Image id="img-G2" src="../assets/shots/G2.png"/>
  <media:Image id="img-G3" src="../assets/shots/G3.png"/>
