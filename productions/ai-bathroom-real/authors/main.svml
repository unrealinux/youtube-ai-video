    <visual:Clip id="clip-D1" image={img-D1} extent={shotExtent}
      during={program.win-D1} frame={full} fit="cover" z="10" motion={m-drift}/>
    <visual:Clip id="clip-D2" image={img-D2} extent={shotExtent}
      during={program.win-D2} frame={full} fit="cover" z="10" motion={m-push}/>
    <visual:Clip id="clip-D3" image={img-D3} extent={shotExtent}
      during={program.win-D3} frame={full} fit="cover" z="10" motion={m-pull}/>
    <visual:Clip id="clip-E1" image={img-E1} extent={shotExtent}
