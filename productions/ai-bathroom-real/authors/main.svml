  <mediaop:Normalize id="vonorm-H2" source={vo-H2} video="none" audio="default"
    span-authority="audio" clock={clock}/>
  <mediaop:Normalize id="vonorm-H3" source={vo-H3} video="none" audio="default"
    span-authority="audio" clock={clock}/>
  <mediaop:Normalize id="vonorm-H4" source={vo-H4} video="none" audio="default"
    span-authority="audio" clock={clock}/>
  <mediaop:Normalize id="vonorm-H5" source={vo-H5} video="none" audio="default"
    span-authority="audio" clock={clock}/>

  <time:Timeline id="program" clock={clock} end="2874f">
    <time:Window id="win-A1" from="0f" until="120f"/>
    <time:Window id="win-A2" from="120f" until="166f"/>
    <time:Window id="win-A3" from="166f" until="256f"/>
    <time:Window id="win-A4" from="256f" until="363f"/>
    <time:Window id="win-A5" from="363f" until="420f"/>
    <time:Window id="win-B1" from="420f" until="524f"/>
    <time:Window id="win-B2" from="524f" until="617f"/>
    <time:Window id="win-B3" from="617f" until="729f"/>
    <time:Window id="win-B4" from="729f" until="821f"/>
    <time:Window id="win-C1" from="821f" until="915f"/>
    <time:Window id="win-C2" from="915f" until="1003f"/>
    <time:Window id="win-C3" from="1003f" until="1121f"/>
    <time:Window id="win-C4" from="1121f" until="1224f"/>
    <time:Window id="win-C5" from="1224f" until="1254f"/>
    <time:Window id="win-D1" from="1254f" until="1402f"/>
    <time:Window id="win-D2" from="1402f" until="1477f"/>
    <time:Window id="win-D3" from="1477f" until="1560f"/>
    <time:Window id="win-E1" from="1560f" until="1643f"/>
    <time:Window id="win-E2" from="1643f" until="1733f"/>
    <time:Window id="win-E3" from="1733f" until="1859f"/>
    <time:Window id="win-F1" from="1859f" until="1952f"/>
    <time:Window id="win-F2" from="1952f" until="2055f"/>
    <time:Window id="win-F3" from="2055f" until="2132f"/>
    <time:Window id="win-F4" from="2132f" until="2219f"/>
    <time:Window id="win-G1" from="2219f" until="2293f"/>
    <time:Window id="win-G2" from="2293f" until="2350f"/>
    <time:Window id="win-G3" from="2350f" until="2435f"/>
    <time:Window id="win-H1" from="2435f" until="2500f"/>
    <time:Window id="win-H2" from="2500f" until="2578f"/>
    <time:Window id="win-H3" from="2578f" until="2673f"/>
    <time:Window id="win-H4" from="2673f" until="2766f"/>
    <time:Window id="win-H5" from="2766f" until="2874f"/>
  </time:Timeline>

  <visual:Track id="picture" timeline={program.timeline}>
    <visual:Clip id="clip-A1" image={img-A1} extent={shotExtent}
      during={program.win-A1} frame={full} fit="cover" z="10" motion={m-push}/>
    <visual:Clip id="clip-A2" image={img-A2} extent={shotExtent}
      during={program.win-A2} frame={full} fit="cover" z="10" motion={m-pull}/>
    <visual:Clip id="clip-A3" image={img-A3} extent={shotExtent}
      during={program.win-A3} frame={full} fit="cover" z="10" motion={m-pan-l}/>
    <visual:Clip id="clip-A4" image={img-A4} extent={shotExtent}
      during={program.win-A4} frame={full} fit="cover" z="10" motion={m-pan-r}/>
    <visual:Clip id="clip-A5" image={img-A5} extent={shotExtent}
      during={program.win-A5} frame={full} fit="cover" z="10" motion={m-drift}/>
    <visual:Clip id="clip-B1" image={img-B1} extent={shotExtent}
      during={program.win-B1} frame={full} fit="cover" z="10" motion={m-push}/>
    <visual:Clip id="clip-B2" image={img-B2} extent={shotExtent}
      during={program.win-B2} frame={full} fit="cover" z="10" motion={m-pull}/>
    <visual:Clip id="clip-B3" image={img-B3} extent={shotExtent}
      during={program.win-B3} frame={full} fit="cover" z="10" motion={m-pan-l}/>
    <visual:Clip id="clip-B4" image={img-B4} extent={shotExtent}
      during={program.win-B4} frame={full} fit="cover" z="10" motion={m-pan-r}/>
    <visual:Clip id="clip-C1" image={img-C1} extent={shotExtent}
      during={program.win-C1} frame={full} fit="cover" z="10" motion={m-drift}/>
    <visual:Clip id="clip-C2" image={img-C2} extent={shotExtent}
      during={program.win-C2} frame={full} fit="cover" z="10" motion={m-push}/>
    <visual:Clip id="clip-C3" image={img-C3} extent={shotExtent}
      during={program.win-C3} frame={full} fit="cover" z="10" motion={m-pull}/>
    <visual:Clip id="clip-C4" image={img-C4} extent={shotExtent}
      during={program.win-C4} frame={full} fit="cover" z="10" motion={m-pan-l}/>
    <visual:Clip id="clip-C5" image={img-C5} extent={shotExtent}
