  <media:Audio id="vo-H5" src="../assets/voice/H5.wav"/>

  <mediaop:Normalize id="vonorm-A1" source={vo-A1} video="none" audio="default"
    span-authority="audio" clock={clock}/>
  <mediaop:Normalize id="vonorm-A2" source={vo-A2} video="none" audio="default"
    span-authority="audio" clock={clock}/>
  <mediaop:Normalize id="vonorm-A3" source={vo-A3} video="none" audio="default"
    span-authority="audio" clock={clock}/>
  <mediaop:Normalize id="vonorm-A4" source={vo-A4} video="none" audio="default"
