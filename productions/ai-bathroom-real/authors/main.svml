    <audio:Clip id="acl-E2" source={vonorm-E2.media} during={program.win-E2}/>
    <audio:Clip id="acl-E3" source={vonorm-E3.media} during={program.win-E3}/>
    <audio:Clip id="acl-F1" source={vonorm-F1.media} during={program.win-F1}/>
    <audio:Clip id="acl-F2" source={vonorm-F2.media} during={program.win-F2}/>
    <audio:Clip id="acl-F3" source={vonorm-F3.media} during={program.win-F3}/>
    <audio:Clip id="acl-F4" source={vonorm-F4.media} during={program.win-F4}/>
    <audio:Clip id="acl-G1" source={vonorm-G1.media} during={program.win-G1}/>
    <audio:Clip id="acl-G2" source={vonorm-G2.media} during={program.win-G2}/>
    <audio:Clip id="acl-G3" source={vonorm-G3.media} during={program.win-G3}/>
    <audio:Clip id="acl-H1" source={vonorm-H1.media} during={program.win-H1}/>
    <audio:Clip id="acl-H2" source={vonorm-H2.media} during={program.win-H2}/>
    <audio:Clip id="acl-H3" source={vonorm-H3.media} during={program.win-H3}/>
    <audio:Clip id="acl-H4" source={vonorm-H4.media} during={program.win-H4}/>
    <audio:Clip id="acl-H5" source={vonorm-H5.media} during={program.win-H5}/>
  </audio:Track>

  <text:Flow id="lbl-A1" timeline={program.timeline} within={labelFrame}
    style={labelStyle} z="60" align="center" block-align="center"
    during={program.win-A1}>AI BATHROOM, MADE REAL</text:Flow>
  <text:Flow id="lbl-A2" timeline={program.timeline} within={labelFrame}
    style={labelStyle} z="60" align="center" block-align="center"
    during={program.win-A2}>THE AI DESIGN</text:Flow>
  <text:Flow id="lbl-A5" timeline={program.timeline} within={labelFrame}
    style={labelStyle} z="60" align="center" block-align="center"
    during={program.win-A5}>STEP 1: DEMO</text:Flow>
  <text:Flow id="lbl-B1" timeline={program.timeline} within={labelFrame}
    style={labelStyle} z="60" align="center" block-align="center"
    during={program.win-B1}>mouldy, obviously</text:Flow>
  <text:Flow id="lbl-B4" timeline={program.timeline} within={labelFrame}
    style={labelStyle} z="60" align="center" block-align="center"
    during={program.win-B4}>START WITH THE SINK</text:Flow>
  <text:Flow id="lbl-C4" timeline={program.timeline} within={labelFrame}
    style={labelStyle} z="60" align="center" block-align="center"
    during={program.win-C4}>counterweight</text:Flow>
  <text:Flow id="lbl-D1" timeline={program.timeline} within={labelFrame}
    style={labelStyle} z="60" align="center" block-align="center"
    during={program.win-D1}>REAL or FAKE?</text:Flow>
  <text:Flow id="lbl-E1" timeline={program.timeline} within={labelFrame}
    style={labelStyle} z="60" align="center" block-align="center"
    during={program.win-E1}>THE AI WASHBASIN</text:Flow>
  <text:Flow id="lbl-F3" timeline={program.timeline} within={labelFrame}
    style={labelStyle} z="60" align="center" block-align="center"
    during={program.win-F3}>install the flush</text:Flow>
  <text:Flow id="lbl-H1" timeline={program.timeline} within={labelFrame}
    style={labelStyle} z="60" align="center" block-align="center"
    during={program.win-H1}>THE RESULT</text:Flow>
  <text:Flow id="lbl-H5" timeline={program.timeline} within={labelFrame}
    style={labelStyle} z="60" align="center" block-align="center"
    during={program.win-H5}>SUGGESTIONS???</text:Flow>

  <film:Film id="main" canvas={vertical.canvas} timeline={program.timeline} appearance={style.film.main}>
    <film:Track source={picture.visual}/>
    <film:Track source={voice.audio}/>
    <film:Track source={lbl-A1.visual}/>
    <film:Track source={lbl-A2.visual}/>
    <film:Track source={lbl-A5.visual}/>
    <film:Track source={lbl-B1.visual}/>
    <film:Track source={lbl-B4.visual}/>
    <film:Track source={lbl-C4.visual}/>
    <film:Track source={lbl-D1.visual}/>
    <film:Track source={lbl-E1.visual}/>
    <film:Track source={lbl-F3.visual}/>
    <film:Track source={lbl-H1.visual}/>
    <film:Track source={lbl-H5.visual}/>
  </film:Film>

  <html:Video id="final" composition={main.composition} timeline={program.timeline}/>
</svml>
