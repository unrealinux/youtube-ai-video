    <visual:Clip id="clip-H3" image={img-H3} extent={shotExtent}
      during={program.win-H3} frame={full} fit="cover" z="10" motion={m-drift}/>
    <visual:Clip id="clip-H4" image={img-H4} extent={shotExtent}
      during={program.win-H4} frame={full} fit="cover" z="10" motion={m-push}/>
    <visual:Clip id="clip-H5" image={img-H5} extent={shotExtent}
      during={program.win-H5} frame={full} fit="cover" z="10" motion={m-pull}/>
  </visual:Track>

  <audio:Track id="voice" timeline={program.timeline}>
    <audio:Clip id="acl-A1" source={vonorm-A1.media} during={program.win-A1}/>
    <audio:Clip id="acl-A2" source={vonorm-A2.media} during={program.win-A2}/>
    <audio:Clip id="acl-A3" source={vonorm-A3.media} during={program.win-A3}/>
    <audio:Clip id="acl-A4" source={vonorm-A4.media} during={program.win-A4}/>
    <audio:Clip id="acl-A5" source={vonorm-A5.media} during={program.win-A5}/>
    <audio:Clip id="acl-B1" source={vonorm-B1.media} during={program.win-B1}/>
    <audio:Clip id="acl-B2" source={vonorm-B2.media} during={program.win-B2}/>
    <audio:Clip id="acl-B3" source={vonorm-B3.media} during={program.win-B3}/>
    <audio:Clip id="acl-B4" source={vonorm-B4.media} during={program.win-B4}/>
    <audio:Clip id="acl-C1" source={vonorm-C1.media} during={program.win-C1}/>
