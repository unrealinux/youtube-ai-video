    <visual:Clip id="clip-F2" image={img-F2} extent={shotExtent}
      during={program.win-F2} frame={full} fit="cover" z="10" motion={m-pull}/>
    <visual:Clip id="clip-F3" image={img-F3} extent={shotExtent}
      during={program.win-F3} frame={full} fit="cover" z="10" motion={m-pan-l}/>
    <visual:Clip id="clip-F4" image={img-F4} extent={shotExtent}
      during={program.win-F4} frame={full} fit="cover" z="10" motion={m-pan-r}/>
    <visual:Clip id="clip-G1" image={img-G1} extent={shotExtent}
