  <mediaop:Normalize id="vonorm-F3" source={vo-F3} video="none" audio="default"
    span-authority="audio" clock={clock}/>
  <mediaop:Normalize id="vonorm-F4" source={vo-F4} video="none" audio="default"
    span-authority="audio" clock={clock}/>
  <mediaop:Normalize id="vonorm-G1" source={vo-G1} video="none" audio="default"
