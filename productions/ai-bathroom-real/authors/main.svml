<?svml using="@hypit/markup@1"?>
<svml>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="media" from="@hypit/media@1"/>
  <import as="mediaop" from="@hypit/media-operations@1"/>
  <import as="visual" from="@hypit/visual-track@1"/>
  <import as="audio" from="@hypit/audio-track@1"/>
  <import as="text" from="@hypit/text-fine@1"/>
  <import as="fonts" from="@hypit/fontsource@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="style" source="../styles.svs"/>

  <time:Clock id="clock" frame-rate="30"/>
  <space:Canvas id="vertical" width="1080" height="1920"/>
  <space:Frame id="full" within={vertical.bounds} left="0px" top="0px" right="100%" bottom="100%"/>
  <space:Frame id="labelFrame" within={vertical.bounds} left="5%" top="6%" right="95%" bottom="36%"/>
  <space:Extent id="shotExtent" width="736" height="1312"/>

  <fonts:Face id="face" package="@fontsource-variable/inter" weight="800" style="normal"/>
  <media:FontStack id="font" primary={face}/>
  <text:Style id="labelStyle" recipe={style.text.label} font={font}>
    <text:Fill color="#FFE24B"/>
    <text:Shadow color="#000000" x="0" y="5" blur="9"/>
  </text:Style>

  <visual:Motion id="m-push">
            <visual:Pose at="start" scale="1.02" easing="ease-out"/>
            <visual:Pose at="end" scale="1.12"/>
  </visual:Motion>
  <visual:Motion id="m-pull">
            <visual:Pose at="start" scale="1.12" easing="ease-out"/>
            <visual:Pose at="end" scale="1.02"/>
  </visual:Motion>
  <visual:Motion id="m-pan-l">
            <visual:Pose at="start" x="34" scale="1.14" easing="ease-out"/>
            <visual:Pose at="end" x="-34" scale="1.14"/>
  </visual:Motion>
  <visual:Motion id="m-pan-r">
            <visual:Pose at="start" x="-34" scale="1.14" easing="ease-out"/>
            <visual:Pose at="end" x="34" scale="1.14"/>
  </visual:Motion>
  <visual:Motion id="m-drift">
            <visual:Pose at="start" y="26" scale="1.13" easing="ease-out"/>
            <visual:Pose at="end" y="-26" scale="1.13"/>
  </visual:Motion>

  <media:Image id="img-A1" src="../assets/shots/A1.png"/>
  <media:Image id="img-A2" src="../assets/shots/A2.png"/>
  <media:Image id="img-A3" src="../assets/shots/A3.png"/>
  <media:Image id="img-A4" src="../assets/shots/A4.png"/>
  <media:Image id="img-A5" src="../assets/shots/A5.png"/>
  <media:Image id="img-B1" src="../assets/shots/B1.png"/>
  <media:Image id="img-B2" src="../assets/shots/B2.png"/>
  <media:Image id="img-B3" src="../assets/shots/B3.png"/>
  <media:Image id="img-B4" src="../assets/shots/B4.png"/>
  <media:Image id="img-C1" src="../assets/shots/C1.png"/>
  <media:Image id="img-C2" src="../assets/shots/C2.png"/>
  <media:Image id="img-C3" src="../assets/shots/C3.png"/>
  <media:Image id="img-C4" src="../assets/shots/C4.png"/>
  <media:Image id="img-C5" src="../assets/shots/C5.png"/>
  <media:Image id="img-D1" src="../assets/shots/D1.png"/>
  <media:Image id="img-D2" src="../assets/shots/D2.png"/>
  <media:Image id="img-D3" src="../assets/shots/D3.png"/>
